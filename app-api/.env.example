# Flask / JWT
FLASK_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8080
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400
JWT_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080

# Firebase Admin SDK: use either a JSON string or a local file path.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_INIT_REQUIRED=true
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Firebase Web SDK (local test page only)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# External services
AI_SERVER_URL=http://localhost:5001/analyze
WEARTHER_AI_BASE_URL=http://localhost:6000
PUBLIC_APP_URL=http://localhost:8080
